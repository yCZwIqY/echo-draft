{
  "name": "draft-novel",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "build": "pnpm electron:build && react-router build",
    "dev": "pnpm electron:build && concurrently \"vite\" \"cross-env BROWSER=none electron dist-electron/main.js\"",
    "start": "pnpm electron:build && concurrently \"vite\" \"cross-env BROWSER=none electron dist-electron/main.js\"",
    "electron:build": "tsc -p tsconfig.electron.json",
    "typecheck": "react-router typegen && tsc && tsc -p tsconfig.electron.json --noEmit"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.30.0",
    "@react-router/node": "7.15.0",
    "@react-router/serve": "7.15.0",
    "@tiptap/core": "^3.23.6",
    "@tiptap/extensions": "^3.23.6",
    "@tiptap/pm": "^3.23.6",
    "@tiptap/react": "^3.23.6",
    "@tiptap/starter-kit": "^3.23.6",
    "axios": "^1.16.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "framer-motion": "^12.40.0",
    "isbot": "^5.1.36",
    "jy-headless": "^0.4.1",
    "ollama": "^0.6.3",
    "prettier": "^3.8.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hot-toast": "^2.6.0",
    "react-icons": "^5.6.0",
    "react-router": "7.15.0",
    "sqlite3": "^6.0.1",
    "tailwind-variants": "^3.2.2",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@react-router/dev": "7.15.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sqlite3"
    ]
  }
}
